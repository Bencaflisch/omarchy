# Single source of truth for OMARCHY_PATH + PATH adjustments. Sourced by:
#   /etc/profile.d/omarchy.sh                 (system login shells)
#   /etc/skel/.bashrc                         (interactive shells)
#   /usr/share/uwsm/env.d/10-omarchy          (Hyprland session via uwsm)
#   /usr/share/omarchy/default/bash/envs      (bash rc chain; SSH/non-login)

# /etc/omarchy.conf is written by omarchy-dev-link and reset by
# omarchy-dev-unlink. When absent, force the packaged default instead of
# preserving a stale inherited value.
if [ -f /etc/omarchy.conf ]; then
  . /etc/omarchy.conf
  : "${OMARCHY_PATH:=/usr/share/omarchy}"
else
  OMARCHY_PATH=/usr/share/omarchy
fi
export OMARCHY_PATH

# A regional install (/etc/omarchy/region, written by the installer) points
# developer tools at that region's registries. Root skips all of it, taking
# back included: on a dev link OMARCHY_PATH is a user-writable checkout.
omarchy_region=
if [ "$(id -u)" = 0 ]; then
  omarchy_region=root
elif [ -r "${OMARCHY_REGION_FILE:-/etc/omarchy/region}" ]; then
  # read fails on a marker without a final newline; startup shells may run set -e.
  read -r omarchy_region <"${OMARCHY_REGION_FILE:-/etc/omarchy/region}" || :
fi
case "$omarchy_region" in
  root) ;;
  [a-z][a-z])
    omarchy_region_file="$OMARCHY_PATH/default/regions/$omarchy_region/environment"
    if [ -r "$omarchy_region_file" ]; then
      # Note which registries this shell sets itself, so a shell started after
      # a switch to World can take back exactly those. The profile keeps any
      # non-empty value the user set first.
      omarchy_region_names=
      while IFS= read -r omarchy_region_line || [ -n "$omarchy_region_line" ]; do
        case "$omarchy_region_line" in
          "export "*=*)
            omarchy_region_name=${omarchy_region_line#export }
            omarchy_region_name=${omarchy_region_name%%=*}
            case "$omarchy_region_name" in
              "" | [0-9]* | *[!A-Z0-9_]*) ;;
              *) eval "[ -n \"\${$omarchy_region_name:+set}\" ]" || omarchy_region_names="$omarchy_region_names $omarchy_region_name" ;;
            esac
            ;;
        esac
      done <"$omarchy_region_file"
      . "$omarchy_region_file"
      [ -z "$omarchy_region_names" ] || export OMARCHY_REGION_EXPORTED="${OMARCHY_REGION_EXPORTED:+$OMARCHY_REGION_EXPORTED }${omarchy_region_names# }"
    fi
    ;;
  *)
    # A desktop session started in a region passes its registries on until the
    # next login. A shell started after a switch to World drops each one that
    # still holds a region's value, and keeps any the user has set since.
    if [ -n "${OMARCHY_REGION_EXPORTED:-}" ]; then
      # Each region's own exports, with the values its file sets, and nothing else.
      omarchy_region_values=$(env -i OMARCHY_PATH="$OMARCHY_PATH" sh -c '
        for f in "$OMARCHY_PATH"/default/regions/*/environment; do
          (
            . "$f" || exit 0
            while IFS= read -r l || [ -n "$l" ]; do
              case "$l" in "export "*=*) ;; *) continue ;; esac
              n=${l#export }
              n=${n%%=*}
              case "$n" in "" | [0-9]* | *[!A-Z0-9_]*) continue ;; esac
              eval "printf \"%s=%s\\n\" \"\$n\" \"\${$n-}\""
            done <"$f"
          )
        done' 2>/dev/null)
      omarchy_region_names=$OMARCHY_REGION_EXPORTED
      while [ -n "$omarchy_region_names" ]; do
        omarchy_region_name=${omarchy_region_names%% *}
        omarchy_region_names=${omarchy_region_names#"$omarchy_region_name"}
        omarchy_region_names=${omarchy_region_names# }
        case "$omarchy_region_name" in
          "" | [0-9]* | *[!A-Z0-9_]*) continue ;;
        esac
        eval "omarchy_region_line=\${$omarchy_region_name-}"
        case "
$omarchy_region_values
" in
          *"
$omarchy_region_name=$omarchy_region_line
"*) unset "$omarchy_region_name" ;;
        esac
      done
    fi
    unset OMARCHY_REGION_EXPORTED
    ;;
esac
unset omarchy_region omarchy_region_file omarchy_region_names omarchy_region_line omarchy_region_name omarchy_region_values

# Only prepend in dev-link mode. On a production install, the binaries are
# already on PATH as /usr/bin/omarchy-* via the omarchy package — prepending
# /usr/share/omarchy/bin would just be noise.
if [ "$OMARCHY_PATH" != /usr/share/omarchy ]; then
  case ":$PATH:" in
    *":${OMARCHY_PATH%/}/bin:"*) ;;
    *) PATH="${OMARCHY_PATH%/}/bin${PATH:+:$PATH}" ;;
  esac
fi

# mise's command wrappers must precede real tool directories inherited from a
# parent shell, so scripts follow account switches without Bash functions.
# mise activate also keeps this directory ahead of its managed tool binaries.
omarchy_wrapper_dir="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}/command-wrappers/bin"
omarchy_wrapper_path=$omarchy_wrapper_dir
if [ -n "${PATH:-}" ]; then
  omarchy_remaining_path=$PATH
  while :; do
    omarchy_path_entry=${omarchy_remaining_path%%:*}
    if [ "$omarchy_path_entry" != "$omarchy_wrapper_dir" ]; then
      omarchy_wrapper_path="$omarchy_wrapper_path:$omarchy_path_entry"
    fi
    case "$omarchy_remaining_path" in
      *:*) omarchy_remaining_path=${omarchy_remaining_path#*:} ;;
      *) break ;;
    esac
  done
fi
PATH=$omarchy_wrapper_path
unset omarchy_wrapper_dir omarchy_wrapper_path omarchy_remaining_path omarchy_path_entry

# User-level tool paths, appended so system binaries keep precedence. This is
# what lets login shells (ssh, bash -lc) and the uwsm session find mise-managed
# tools without an interactive rc. Keep these directories in sync with the PAM
# PATH line from install/config/ssh-command-path.sh, which covers SSH commands
# that run no shell setup at all.
case ":$PATH:" in
  *":$HOME/.local/share/mise/shims:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/share/mise/shims" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/bin" ;;
esac
export PATH
