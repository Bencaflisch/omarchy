#!/bin/bash -p

# omarchy:summary=Set where packages and developer tools download from: world or china
# omarchy:args=<world|china>
# omarchy:examples=omarchy region china | omarchy region world
# omarchy:requires-sudo=true

# Privileged mode keeps BASH_ENV and exported functions from running before the
# first command: this script goes on to change /etc/pacman.conf through sudo.
if [[ $- != *p* ]]; then
  echo "Refusing an unsafe Bash startup." >&2
  exit 126
fi

security_entrypoint=$(/usr/bin/readlink -e -- "${BASH_SOURCE[0]}") || exit 126
source "${security_entrypoint%/*}/omarchy-security-functions" || exit 126
omarchy_security_require_privileged_bash_startup || exit 126
set -e
omarchy_security_sanitize_bash_environment "$0" "$@"
omarchy_security_require_source_root "$0"
omarchy_security_install_sudo_cleanup_traps
omarchy_security_revoke_sudo_timestamp || exit 1
omarchy_security_enable_no_update_sudo

case "${1:-}" in
  world) region=global ;;
  china) region=cn ;;
  *) echo "Usage: omarchy-region <world|china>" >&2; exit 1 ;;
esac

channel=$(omarchy-channel-current)
case "$channel" in
  dev) channel=edge ;;
  stable | rc | edge) ;;
  *) echo "Cannot tell this machine's package channel. Nothing changed." >&2; exit 1 ;;
esac

# One writer of pacman's files at a time, for every user: a second switch, or
# a refresh, started while this one waits for its password would otherwise
# replace the backups it goes back to. The lock is /etc/pacman.d, which any
# user can open and nothing replaces, unlike pacman.conf, which a refresh
# hook may rewrite with sed -i; omarchy-refresh-pacman takes the same lock.
exec 9</etc/pacman.d
if ! flock -n 9; then
  echo "Another region switch or pacman refresh is running. Nothing changed." >&2
  exit 1
fi

# Everything is prepared as the caller. The developer tool settings change
# first, since undoing them needs no sudo; then root copies the two finished
# pacman files and moves the marker into place, back to back. The marker on
# disk decides the outcome: until it names the new region, every exit,
# including a failure, a closed terminal or Ctrl+C, puts the old region back.
target=world
[[ $region == "global" ]] || target=china
previous=global
[[ $(omarchy-region-current) == "china" ]] && previous=cn
work=$(mktemp -d)
cargo_config=${CARGO_HOME:-$HOME/.cargo}/config.toml
cargo_link=
changed=0
finished=0
restore_previous() {
  # The user's own cargo config comes back as it was, block or no block,
  # and a symlinked one as the same link.
  [[ -z $cargo_link ]] || ln -sfn -- "$cargo_link" "$cargo_config" || true
  if [[ -e $work/cargo.toml ]]; then
    cp -p -- "$work/cargo.toml" "$cargo_config" || true
  elif [[ -z $cargo_link ]]; then
    rm -f -- "$cargo_config" || true
  fi
  if sudo cp -f /etc/pacman.conf.bak /etc/pacman.conf &&
    sudo cp -f /etc/pacman.d/mirrorlist.bak /etc/pacman.d/mirrorlist; then
    sudo rm -f /etc/omarchy/region.new || true
    echo "Nothing changed: the region is still $(omarchy-region-current)." >&2
  else
    echo "The package mirrors could not be put back. Run 'omarchy-region $(omarchy-region-current)' to finish." >&2
  fi
}
cleanup_region() {
  local status=$?
  # Reapplying the current region leaves the marker as it was, so there only
  # reaching the end counts.
  if (( changed && ! finished )) && [[ $previous == $region || $(omarchy-region-current) != $target ]]; then
    restore_previous
  fi
  rm -rf "$work"
  omarchy_security_exit_with_revoked_sudo "$status"
}
trap cleanup_region EXIT

mkdir -p "$work/target/etc/omarchy" "$work/rendered"
[[ $region == "global" ]] || printf '%s\n' "$region" >"$work/target/etc/omarchy/region"
"$OMARCHY_PATH/bin/omarchy-apply-pacman" --render "$channel" "$work/rendered" "$work/target"

# A region's first servers must answer before anything is switched to them.
# ARM mirrorlists open with comments, so read the first Server line.
if [[ $region != "global" ]]; then
  arch=x86_64
  ! omarchy-hw-aarch64 || arch=aarch64
  omarchy_server=$(awk '$0 == "[omarchy]" { getline; sub(/^Server = /, ""); print; exit }' "$work/rendered/pacman.conf")
  arch_server=$(awk '/^Server = / { sub(/^Server = /, ""); print; exit }' "$work/rendered/mirrorlist")
  for url in "${omarchy_server//\$arch/$arch}/omarchy.db" "$(sed "s|\$repo|core|; s|\$arch|$arch|" <<<"$arch_server")/core.db"; do
    if ! curl -fsSL --max-time 20 -o /dev/null "$url"; then
      echo "Could not reach $url. Nothing changed." >&2
      exit 1
    fi
  done
fi

sudo cp -f /etc/pacman.conf /etc/pacman.conf.bak
sudo cp -f /etc/pacman.d/mirrorlist /etc/pacman.d/mirrorlist.bak
[[ ! -L $cargo_config ]] || cargo_link=$(readlink -- "$cargo_config")
[[ ! -e $cargo_config ]] || cp -p -- "$cargo_config" "$work/cargo.toml"
changed=1
omarchy-region-user "$region"
sudo cp -f "$work/rendered/pacman.conf" /etc/pacman.conf
sudo cp -f "$work/rendered/mirrorlist" /etc/pacman.d/mirrorlist
# A rename, so the marker is always either the old region or the new one.
if [[ $region == "global" ]]; then
  sudo rm -f /etc/omarchy/region
else
  sudo install -D -m 0644 "$work/target/etc/omarchy/region" /etc/omarchy/region.new
  sudo mv -f /etc/omarchy/region.new /etc/omarchy/region
fi

finished=1
echo "Region set to $1. Terminals opened from now on use its registries; apps started from the desktop follow after you log in again."
