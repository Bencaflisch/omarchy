#!/bin/bash

# omarchy:summary=Install rtkit and repair realtime budgets left at zero without it
# omarchy:hidden=true
# omarchy:requires-sudo=true

# Without rtkit, xdg-desktop-portal reports a realtime budget of 0, and
# PipeWire's client module-rt applies it as a hard RLIMIT_RTTIME of 0. The
# shell is such a client, so everything it launches inherits the zero. Once
# rtkit is installed it accepts any hard limit at or below its own budget, 0
# included, so a thread of such a process can be made realtime, and the kernel
# then kills the process at its first RT watchdog check.
#
# The machine-wide repair runs once, as root: raise every logged-in user's
# hard zero to rtkit's default budget of 200 ms, install rtkit, then raise the
# zeros to its live budget, restart each logged-in user's portal that still
# reports a zero budget, and raise the zeros that appeared meanwhile. The
# raise has to come before the install: dbus-broker watches its service
# directories, so rtkit can be activated as soon as pacman extracts it, before
# any install script or hook runs. A root-owned marker, written before the
# install and removed once the repair has finished, makes an interrupted repair
# run again. A machine that got rtkit any other way, such as a fresh install,
# never has one, so later runs, and other users' runs, need no sudo.
#
# Every run then repairs the caller's own session: it raises the caller's own
# zeros, which needs sudo only when there are any, restarts the caller's
# portal if it reports a zero budget, raises the zeros that appeared
# meanwhile, and restarts the caller's audio units if the PipeWire server is
# not realtime yet, since PipeWire only asks rtkit for priority at startup.
#
# This never prompts: without cached sudo the machine-wide repair stops, and
# the caller stays pending until a run that has it, such as omarchy update.
# Anything it cannot inspect is a failure, never "nothing to do".

proc_root=${OMARCHY_PROC_ROOT:-/proc}
pending=${OMARCHY_REALTIME_REPAIR_PENDING:-/var/lib/omarchy/realtime-repair-pending}

fail() {
  echo "$1" >&2
  exit 1
}

need_sudo() {
  sudo -n true 2>/dev/null ||
    fail "Repairing realtime budgets needs sudo without a prompt; the next omarchy update finishes it."
}

hard_rttime() {
  awk '/^Max realtime timeout/ { print $5; found = 1 } END { exit !found }' "$1/limits" 2>/dev/null
}

# Field 22 of /proc/<pid>/stat, counted after the command name, which can
# hold spaces, parentheses and newlines of its own.
start_time() {
  local stat fields

  { stat=$(<"$1/stat"); } 2>/dev/null || return 1
  read -ra fields <<<"${stat##*) }"
  [[ -n ${fields[19]} ]] && echo "${fields[19]}"
}

# Lines of "pid starttime uid" for logged-in users' processes with a hard
# zero. The start time is read before and after, so a PID reused meanwhile is
# not mistaken for the process whose owner was read.
scan_zero_rttime() {
  local dir start uid hard again

  for dir in "$proc_root"/[0-9]*; do
    # A user's own scan skips other users' processes, which hidepid=1 shows
    # but does not let it read.
    [[ -z ${own_only:-} || -O $dir ]] || continue
    if ! start=$(start_time "$dir") ||
      ! uid=$(awk '/^Uid:/ { print $2; found = 1 } END { exit !found }' "$dir/status" 2>/dev/null) ||
      ! hard=$(hard_rttime "$dir") || ! again=$(start_time "$dir"); then
      [[ -d $dir ]] && fail "Could not read the stat, status or limits of process ${dir##*/}"
      continue
    fi
    [[ $uids == *" $uid "* && $hard == 0 && $again == "$start" ]] && echo "${dir##*/} $start $uid"
  done
  return 0
}

# The scan runs as root: with /proc mounted hidepid, a user cannot read other
# users' processes, so their zeros would be missed (hidepid=2) or every run
# would fail on them (hidepid=1). The UID filter still keeps it to logged-in
# users.
zero_rttime_processes() {
  sudo -n env SCAN_ROOT="$proc_root" SCAN_UIDS="$uids" bash -c \
    "$(declare -f fail start_time hard_rttime scan_zero_rttime)"'; proc_root=$SCAN_ROOT uids=$SCAN_UIDS scan_zero_rttime'
}

# Processes keep forking while a pass runs, so repeat until a pass finds no
# zero. Each target is checked again just before prlimit: the same process
# (start time and owner unchanged) still at a hard zero, so neither a reused
# PID nor a limit someone else has just set is overwritten.
raise_zero_budgets() {
  local budget=$1 targets

  for _ in {1..10}; do
    targets=$(zero_rttime_processes) || exit 1
    [[ -z $targets ]] && return 0

    sudo -n env PROC_ROOT="$proc_root" BUDGET="$budget" bash -c "$(declare -f start_time)"'
      while read -r pid start uid; do
        dir=$PROC_ROOT/$pid
        [[ $(start_time "$dir") == "$start" ]] || continue
        [[ $(awk "/^Uid:/ { print \$2 }" "$dir/status" 2>/dev/null) == "$uid" ]] || continue
        [[ $(awk "/^Max realtime timeout/ { print \$5 }" "$dir/limits" 2>/dev/null) == 0 ]] || continue
        prlimit --pid "$pid" --rttime="$BUDGET:$BUDGET" || [[ ! -d $dir ]] || exit 1
      done' <<<"$targets" || fail "Could not raise the realtime budget of every process"
  done

  fail "Processes still start with a zero realtime budget: $(zero_rttime_processes | awk '{ printf "%s ", $1 }')"
}

as_user() {
  local user=$1 command=$2
  shift 2

  if [[ $user == "$(id -un)" ]]; then
    "$command" --user "$@"
  else
    sudo -n "$command" --user --machine="$user@" "$@"
  fi
}

portal_budget() {
  as_user "$1" busctl get-property org.freedesktop.portal.Desktop /org/freedesktop/portal/desktop \
    org.freedesktop.portal.Realtime RTTimeUSecMax 2>/dev/null | awk '{ print $2 }'
}

# The portal reads rtkit's budget once, when it starts, so one started before
# rtkit was installed keeps reporting zero. One that is not running reads it
# when it next starts. A portal that already reports a budget is left alone.
repair_portal() {
  local user=$1 state

  state=$(as_user "$user" systemctl show -p ActiveState --value xdg-desktop-portal.service) ||
    fail "Could not read the state of $user's portal"

  case $state in
    inactive | failed) return 0 ;;
    active) ;;
    *) fail "$user's portal is $state; the next run repairs it" ;;
  esac

  [[ $(portal_budget "$user") =~ ^[1-9][0-9]*$ ]] && return 0

  # A failed restart leaves the zero in place, which the check below catches.
  as_user "$user" systemctl restart xdg-desktop-portal.service
  [[ $(portal_budget "$user") =~ ^[1-9][0-9]*$ ]] ||
    fail "$user's portal still reports a zero realtime budget"
}

rtkit_budget() {
  local budget

  budget=$(busctl get-property org.freedesktop.RealtimeKit1 /org/freedesktop/RealtimeKit1 \
    org.freedesktop.RealtimeKit1 RTTimeUSecMax 2>/dev/null | awk '{ print $2 }')
  [[ $budget =~ ^[1-9][0-9]*$ ]] || fail "rtkit reports no realtime budget"
  echo "$budget"
}

repair_machine() {
  local budget user

  need_sudo

  # Regular users only: root and system accounts can log in too, but their
  # processes are services, and a zero limit there may be deliberate.
  users=$(loginctl list-users --no-legend) || fail "Could not list the logged-in users"
  users=$(awk '$1 >= 1000' <<<"$users")
  uids=" $(awk '{ printf "%s ", $1 }' <<<"$users")"

  if omarchy-pkg-missing rtkit; then
    sudo -n install -Dm644 /dev/null "$pending" || fail "Could not record the realtime repair"
    raise_zero_budgets 200000
    omarchy-pkg-add rtkit
  fi

  budget=$(rtkit_budget) || exit 1

  raise_zero_budgets "$budget"
  while read -r _ user _; do
    repair_portal "$user"
  done <<<"$users"
  raise_zero_budgets "$budget"

  sudo -n rm -f "$pending" || fail "Could not record the realtime repair"
}

# A portal whose one read of rtkit failed hands out zeros with rtkit
# installed too, and Flatpak apps still take them from it.
raise_own_zero_budgets() {
  local zeros budget

  uids=" $(id -u) "
  zeros=$(own_only=1 scan_zero_rttime) || exit 1
  [[ -n $zeros ]] || return 0

  need_sudo
  budget=$(rtkit_budget) || exit 1
  raise_zero_budgets "$budget"
}

if omarchy-pkg-missing rtkit || [[ -e $pending ]]; then
  repair_machine
fi

raise_own_zero_budgets
repair_portal "$(id -un)"
raise_own_zero_budgets

# The server is pipewire.service's main process: a filter-chain host, such as
# the speaker tuning, is also named pipewire and may already be realtime.
pipewire=$(systemctl --user show -p MainPID --value pipewire.service) ||
  fail "Could not read PipeWire's main process"
if [[ $pipewire =~ ^[1-9][0-9]*$ && ! $(ps -L -o cls= -p "$pipewire") =~ RR|FF ]]; then
  systemctl --user try-restart pipewire.service pipewire-pulse.service wireplumber.service ||
    fail "Could not restart the audio units"
fi
