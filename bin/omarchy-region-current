#!/bin/bash

# omarchy:summary=Print where packages and developer tools download from: world or china

set -euo pipefail

region=
# read fails on a marker without a final newline, after reading it.
if [[ -r ${OMARCHY_REGION_FILE:-/etc/omarchy/region} ]]; then
  read -r region <"${OMARCHY_REGION_FILE:-/etc/omarchy/region}" || true
fi
case "$region" in
  cn) echo china ;;
  *) echo world ;;
esac
